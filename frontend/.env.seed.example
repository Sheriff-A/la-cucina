# Copy to .env.seed.local (gitignored) and fill in. Read by `npm run db:seed` and
# `npm run db:import-usda`, on top of .env.development.local. See docs/coding.md.

# Neon API key. The seed uses it to confirm which branch DATABASE_URL points at (it refuses
# production) and to create the seeded Neon Auth users. Console → Account settings → API keys.
NEON_API_KEY=

# Folder holding the USDA FoodData Central CSV folders (SR Legacy and Foundation Foods).
# They aren't in the repo: download from https://fdc.nal.usda.gov/download-datasets/
USDA_DATA_DIR=

# Seeded users (ADR-0009): two admins and two readers, development and preview branches only.
# Test values only: never a real password. Changing a password here and re-running the seed
# updates it.
SEED_ADMIN_1_EMAIL=admin1@la-cucina.test
SEED_ADMIN_1_NAME=Admin One
SEED_ADMIN_1_PASSWORD=
SEED_ADMIN_2_EMAIL=admin2@la-cucina.test
SEED_ADMIN_2_NAME=Admin Two
SEED_ADMIN_2_PASSWORD=
SEED_READER_1_EMAIL=reader1@la-cucina.test
SEED_READER_1_NAME=Reader One
SEED_READER_1_PASSWORD=
SEED_READER_2_EMAIL=reader2@la-cucina.test
SEED_READER_2_NAME=Reader Two
SEED_READER_2_PASSWORD=
