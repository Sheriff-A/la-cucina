# Copy the relevant parts into .env.development.local for local dev.
# Neon-managed values (DATABASE_URL, NEON_AUTH_*, ...) land in .env automatically
# via `neon deploy` / `neon env pull` — don't hand-write those here permanently,
# this file just documents what a fresh clone needs.

# Local Docker Postgres (see docker-compose.yml at the repo root). Read explicitly
# from .env.development.local by both Next.js and Prisma (see prisma7.config.ts).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/la_cucina?schema=public"

# Written by `neon deploy` once Neon Auth is provisioned on the linked branch.
# Only needed once the app actually talks to Neon Auth.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
