# Copy to .env.development.local (gitignored) for local dev. See docs/coding.md.
#
# The app and the seed run against the Neon "development" branch (ADR-0010), never
# production. Get these values with:
#   neon env pull --branch development   (writes .env; copy the values here)
# or from Console → Branches → development → Connect.
# Prisma, Next.js and the scripts read .env.development.local; .env is overwritten by
# `neon deploy` / `neon env pull`, so don't rely on it.
DATABASE_URL=
# Direct (non-pooled) connection: used by Prisma Migrate, the seed and the USDA import.
DATABASE_URL_UNPOOLED=

# Neon Auth on the development branch.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Seed credentials and the Neon API key go in .env.seed.local (see .env.seed.example).
# The Docker Postgres for tests goes in .env.test.local (see .env.test.example).
